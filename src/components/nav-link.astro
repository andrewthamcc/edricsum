---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  isCurrentTab: boolean;
  icon: string;
  nav: string;
}

const { href, isCurrentTab, icon, nav } = Astro.props;
---

<a
  href={href}
  class={`py-2.5 sm:py-3 px-1 border-b-2 transition-colors flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 ${
    isCurrentTab
      ? "border-stone-900 text-stone-900 font-semibold"
      : "border-transparent text-stone-500 hover:text-stone-800"
  }`}
>
  <Icon name={icon} class="h-5 w-5 shrink-0 sm:h-4 sm:w-4" />
  <span class="hidden text-xs leading-none capitalize sm:text-sm md:block"
    >{nav}</span
  >
</a>
