---
import { Icon } from "astro-icon/components";
---

<section class="font-sans">
  <div
    class="space-y-6 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8"
  >
    <!-- Top Header & Date -->
    <div
      class="flex flex-col justify-between gap-2 border-b border-stone-100 pb-5 sm:flex-row sm:items-center"
    >
      <h2 class="font-serif text-2xl font-medium text-stone-900">
        Service Details
      </h2>
      <span
        class="inline-flex w-fit items-center rounded-full bg-stone-100 px-3 py-1.5 text-xs font-semibold tracking-wider text-stone-600 uppercase"
      >
        Wednesday, August 19, 2026
      </span>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <!-- Schedule Column -->
      <div class="space-y-4">
        <h3
          class="text-xs font-semibold tracking-wider text-stone-400 uppercase"
        >
          Schedule
        </h3>

        <div class="space-y-3">
          <div
            class="flex items-baseline justify-between border-b border-stone-100 pb-2.5"
          >
            <span class="font-medium text-stone-800">Visitation</span>
            <span class="text-sm font-medium text-stone-600">10:00 AM</span>
          </div>

          <div
            class="flex items-baseline justify-between border-b border-stone-100 pb-2.5"
          >
            <span class="font-medium text-stone-800">Service</span>
            <span class="text-sm font-medium text-stone-600">11:00 AM</span>
          </div>

          <div class="flex items-baseline justify-between pt-0.5">
            <span class="font-medium text-stone-800">Reception</span>
            <span class="text-sm text-stone-500 italic">To follow</span>
          </div>
        </div>
      </div>

      <!-- Location Column -->
      <div class="space-y-4 md:border-l md:border-stone-100 md:pl-8">
        <h3
          class="text-xs font-semibold tracking-wider text-stone-400 uppercase"
        >
          Location
        </h3>

        <div class="space-y-1">
          <p class="leading-snug font-medium text-stone-800">
            Highland Hills Funeral Home &amp; Cemetery
          </p>
          <p class="text-sm text-stone-600">
            12492 Woodbine Ave, Gormley, ON L0H 1G0
          </p>
        </div>

        <div class="pt-2">
          <a
            href="https://maps.app.goo.gl/kBkyA58rDsqeURur8"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md bg-stone-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-black"
          >
            <Icon name="mdi:map-marker-outline" class="h-4 w-4" />
            <span>Open in Maps</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
