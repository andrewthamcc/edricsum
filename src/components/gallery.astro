---
import { Image } from "astro:assets";
import One from "../assets/1.jpg";
import Two from "../assets/2.jpg";
import Three from "../assets/3.jpg";
import Four from "../assets/4.jpg";
import Five from "../assets/5.jpg";
import Six from "../assets/6.jpg";
import Seven from "../assets/7.jpg";
import Eight from "../assets/8.jpg";
import Nine from "../assets/9.jpg";
import Ten from "../assets/10.jpg";
import Eleven from "../assets/11.jpg";
import Twelve from "../assets/12.jpg";
import Thirteen from "../assets/13.jpg";
import Fourteen from "../assets/14.jpg";
import Fifteen from "../assets/15.jpg";
import Sixteen from "../assets/16.jpg";
import Seventeen from "../assets/17.jpg";
import Eighteen from "../assets/18.jpg";
import Nineteen from "../assets/19.jpg";

const IMAGES = [
  One, Two, Three, Four, Five, Six, Seven, Eight, Nine,
  Ten, Eleven, Twelve, Thirteen, Fourteen, Fifteen, Sixteen,
  Seventeen, Nineteen, Eighteen,
];

function shuffleArray<T>(array: T[]): T[] {
  const arr = [...array];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

const shuffledImages = shuffleArray(IMAGES);
---

<section
  class="space-y-6 rounded-2xl border border-stone-200 bg-white p-6 md:p-8 font-sans shadow-sm"
>
  <div class="text-center space-y-1">
    <h2 class="font-serif text-2xl md:text-3xl font-medium text-stone-900">
      Gallery
    </h2>
    <p class="text-xs text-stone-500">Memories through the years</p>
  </div>

  <!-- Grid with Clickable Image Buttons -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
    {
      shuffledImages.map((img, index) => (
        <button
          type="button"
          class="gallery-trigger aspect-square overflow-hidden rounded-xl bg-stone-100 shadow-2xs focus:outline-none focus:ring-2 focus:ring-stone-400 group cursor-pointer text-left"
          data-src={img.src}
          aria-label={`View photo ${index + 1}`}
        >
          <Image
            src={img}
            alt={`Gallery photo ${index + 1}`}
            widths={[300, 600]}
            sizes="(max-width: 640px) 50vw, (max-width: 768px) 33vw, 25vw"
            class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
          />
        </button>
      ))
    }
  </div>
</section>

<!-- Lightbox Modal -->
<dialog
  id="gallery-modal"
  class="fixed inset-0 z-50 max-h-none max-w-none w-full h-full bg-transparent p-4 outline-none backdrop:bg-black/85 backdrop:backdrop-blur-xs open:flex open:items-center open:justify-center"
>
  <div class="relative max-h-[90vh] max-w-[90vw] flex flex-col items-center justify-center">
    <!-- Close Button -->
    <button
      id="modal-close"
      type="button"
      class="absolute -top-12 right-0 rounded-full bg-white/20 p-2 text-white hover:bg-white/40 focus:outline-none transition-colors cursor-pointer"
      aria-label="Close modal"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Modal Image Preview -->
    <img
      id="modal-image"
      src=""
      alt="Expanded gallery memory"
      class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain shadow-2xl"
    />
  </div>
</dialog>

<script>
  const dialog = document.getElementById("gallery-modal") as HTMLDialogElement;
  const modalImg = document.getElementById("modal-image") as HTMLImageElement;
  const closeBtn = document.getElementById("modal-close");
  const triggers = document.querySelectorAll(".gallery-trigger");

  // Open Modal
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const src = trigger.getAttribute("data-src");
      if (src && modalImg && dialog) {
        modalImg.src = src;
        dialog.showModal();
        document.body.style.overflow = "hidden"; // Prevent background scrolling on mobile
      }
    });
  });

  // Close Function
  function closeModal() {
    if (dialog) {
      dialog.close();
      document.body.style.overflow = ""; // Re-enable scrolling
    }
  }

  closeBtn?.addEventListener("click", closeModal);

  // Close when clicking backdrop outside the image
  dialog?.addEventListener("click", (e) => {
    const dialogBounds = dialog.getBoundingClientRect();
    if (
      e.clientX < dialogBounds.left ||
      e.clientX > dialogBounds.right ||
      e.clientY < dialogBounds.top ||
      e.clientY > dialogBounds.bottom ||
      e.target === dialog
    ) {
      closeModal();
    }
  });

  // Handle ESC key restore body scroll
  dialog?.addEventListener("close", () => {
    document.body.style.overflow = "";
  });
</script>