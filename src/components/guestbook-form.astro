<div
  class="space-y-4 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"
>
  <h2 class="font-serif text-2xl font-medium text-stone-900">
    Leave a Tribute
  </h2>

  <form id="guestbook-form" class="space-y-4">
    <div>
      <label
        for="name"
        class="mb-1 block text-left text-xs font-semibold tracking-wider text-stone-500 uppercase"
      >
        Your Name
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full rounded-md border border-stone-300 px-3.5 py-2 text-sm text-stone-800 focus:border-stone-900 focus:outline-none"
        placeholder="e.g., Sarah & Family"
      />
    </div>

    <div>
      <label
        for="message"
        class="mb-1 block text-left text-xs font-semibold tracking-wider text-stone-500 uppercase"
      >
        Tribute or Memory
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full rounded-md border border-stone-300 px-3.5 py-2 text-sm text-stone-800 focus:border-stone-900 focus:outline-none"
        placeholder="Share a favorite story or words of comfort..."></textarea>
    </div>

    <div class="flex items-center justify-between pt-1">
      <button
        type="submit"
        class="rounded-md bg-stone-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-black hover:bg-stone-700 active:bg-black"
      >
        Submit Message
      </button>
      <span id="form-status" class="hidden text-xs text-stone-500"></span>
    </div>
  </form>
</div>

<script>
  import { db } from "../lib/firebase";
  import { collection, addDoc, serverTimestamp } from "firebase/firestore";

  const form = document.getElementById("guestbook-form") as HTMLFormElement;
  const status = document.getElementById("form-status");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (status) {
        status.textContent = "Sending...";
        status.className = "text-xs text-stone-500";
        status.classList.remove("hidden");
      }

      const formData = new FormData(form);

      try {
        await addDoc(collection(db, "guestbook"), {
          name: formData.get("name"),
          message: formData.get("message"),
          timestamp: serverTimestamp(),
        });

        form.reset();
        if (status) {
          status.textContent = "Thank you. Your tribute has been received.";
          status.className = "text-xs text-emerald-700 font-medium";
        }
      } catch (err) {
        console.error("Firestore Write Error:", err);
        if (status) {
          status.textContent = "Something went wrong. Please try again.";
          status.className = "text-xs text-rose-600 font-medium";
        }
      }
    });
  }
</script>
